        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "PATTERN",
            "value": "[ \\t\\r\\n]*=\\+\\}"
          }
        }
      ]
    },
    "interpolation_expression": {
      "type": "SYMBOL",
      "name": "_escaped_expression"
    },
    "raw_interpolation_expression": {
      "type": "SYMBOL",
      "name": "_raw_expression"
    },
    "_double_quoted_expression_text": {
      "type": "PATTERN",
      "value": "[^\"]+"
    },
    "_single_quoted_expression_text": {
      "type": "PATTERN",
      "value": "[^']+"
    }
