      }
    },
    "template_directive_name": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "h-"
            },
            {
              "type": "CHOICE",
              "members": [
