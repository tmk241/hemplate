        },
        {
          "type": "SYMBOL",
          "name": "element"
        }
      ]
    },
    "raw_start_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_raw_start_tag_name"
          },
          "named": true,
          "value": "tag_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
