          "named": true,
          "value": "regular_element"
        }
      ]
    },
    "attribute_name": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[:@#?*.\\[(]*[a-zA-Z0-9_$][a-zA-Z0-9_$.\\-:|#\\])]*"
        }
      }
    },
    "attribute": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PREC",
          "value": 30,
          "content": {
            "type": "SYMBOL",
            "name": "template_directive"
          }
        },
        {
          "type": "SYMBOL",
          "name": "dynamic_attribute"
        },
        {
          "type": "SYMBOL",
          "name": "regular_attribute"
        }
