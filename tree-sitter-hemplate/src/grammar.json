        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "raw_content": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_raw_text_chunk"
            },
            "named": true,
            "value": "text_chunk"
