<template h-key="self.key" h-if="self.first"><span h-custom="a" h-if="self.second">first</span><span h-else h-other="b">fallback</span></template><template h-key="self.key" h-else-if="self.second">second</template><template h-key="self.key" h-else>neither</template><script h-if="self.first">first()</script><style h-if="self.second">p{color:red}</style><template h-for="item/* comment */in/* comment */self.items"><b h-label="item">{+ item +}</b></template><template h-if="let Some(value)=self.value"><i>{+ value +}</i></template>